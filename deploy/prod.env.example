# Production secrets template for Docker Compose or bare-metal deploy.
#
# 1. Copy on the server (never commit the real file):
#      sudo mkdir -p /etc/mtgstore
#      sudo cp deploy/prod.env.example /etc/mtgstore/prod.env
#      sudo chmod 600 /etc/mtgstore/prod.env
# 2. Fill every CHANGE_ME / blank value.
# 3. See deploy/LAUNCH.md for the first deploy walkthrough.
#
# Compose usage:
#   docker compose -f deploy/docker-compose.prod.yml --env-file /etc/mtgstore/prod.env up -d

###> PostgreSQL (only when using the `db` service in docker-compose.prod.yml) ###
POSTGRES_DB=store
POSTGRES_USER=store
POSTGRES_PASSWORD=CHANGE_ME_strong_random

###> Symfony core ###
APP_ENV=prod
# openssl rand -hex 16
APP_SECRET=CHANGE_ME
APP_SHARE_DIR=var/share

# Public site URL (emails, SSO return links, store-owner redirects).
APP_FRONTEND_URL=https://your-domain.example

# Base URL Symfony uses when generating absolute links in CLI/cron contexts.
# With the bundled nginx image, API and SPA share one host — use the same origin.
DEFAULT_URI=https://your-domain.example

###> Database ###
# Compose (internal network): host `db`, credentials must match POSTGRES_* above.
DATABASE_URL=postgresql://store:CHANGE_ME_strong_random@db:5432/store?serverVersion=16&charset=utf8
# Managed Postgres example:
# DATABASE_URL=postgresql://user:pass@db-host.example:5432/store?serverVersion=16&charset=utf8&sslmode=require

###> JWT (keypair lives in a Docker volume — generate after first boot; see LAUNCH.md) ###
JWT_PASSPHRASE=CHANGE_ME_openssl_rand_hex_32

###> CORS ###
# Same-origin deploy (nginx proxies /api): this regex still applies to any cross-origin callers.
CORS_ALLOW_ORIGIN='^https://your-domain\.example$'

###> Mail (Resend) ###
# API key from https://resend.com/api-keys. URL-encode special characters in the key.
# From address MUST be a domain you verified in Resend (SPF + DKIM).
MAILER_DSN=resend+api://re_YOUR_API_KEY@default
APP_MAIL_FROM="LGS Card Vault <noreply@your-domain.example>"

###> Messenger (Doctrine transport — default in repo; use Redis/AMQP at scale) ###
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=csv_import&auto_setup=1
MESSENGER_CSV_TRANSPORT_DSN=doctrine://default?queue_name=store_import&auto_setup=1
MESSENGER_FAILED_TRANSPORT_DSN=doctrine://default?queue_name=failed&auto_setup=1

###> Observability (optional) ###
# SENTRY_DSN=

###> Square — switch to production before taking real money ###
SQUARE_ENVIRONMENT=production

SQUARE_PRODUCTION_APPLICATION_ID=
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_APPLICATION_SECRET=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=

# Must match the webhook subscription URL in the Square dashboard exactly.
SQUARE_WEBHOOK_URL=https://your-domain.example/api/integrations/square/webhook

# OAuth redirect registered in Square → must match character-for-character.
SQUARE_OAUTH_REDIRECT_URI=https://your-domain.example/api/integrations/square/callback

# Leave sandbox keys empty in production unless you run a separate staging stack.
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_APPLICATION_SECRET=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=

# SQUARE_CURRENCY=USD
# SQUARE_COUNTRY=US

###> Google SSO (optional) ###
# SSO_OIDC_ISSUER=https://accounts.google.com
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# Authorized redirect URI in Google Cloud Console must match exactly:
#   https://your-domain.example/api/auth/sso/callback
# SSO_OIDC_REDIRECT_URI=https://your-domain.example/api/auth/sso/callback

###> Mapbox (optional — onboarding address autocomplete) ###
# MAPBOX_ACCESS_TOKEN=
