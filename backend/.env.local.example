# Copy to backend/.env.local and fill in values. Never commit .env.local.

# Absolute URLs for OAuth callbacks (Square redirect URI must match exactly).
# start-dev.ps1 / start-dev.sh set this automatically; override here if needed.
# DEFAULT_URI=http://127.0.0.1:8000
# Must match Square OAuth redirect URL exactly (also whitelisted in Square dashboard).
# SQUARE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/square/callback

###> Square ###
# Sandbox and production credentials live side by side; this selects which set
# is used, so going live is a one-variable change. A missing production
# credential means mock mode rather than sandbox keys hitting the live API.
SQUARE_ENVIRONMENT=sandbox

# From https://developer.squareup.com/apps -> your application:
#   Credentials tab (Sandbox toggle) -> Application ID + Access token
#   Locations tab   (Sandbox toggle) -> Location ID
# Leave blank to run payments in mock mode.
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
# Only needed to connect stores via OAuth so they can charge their own shoppers.
SQUARE_SANDBOX_APPLICATION_SECRET=

# Webhooks tab -> your subscription -> Signature key. Without it the webhook
# endpoint rejects everything, and refunds, disputes and merchants
# disconnecting never reach us.
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
# Must match the subscription's notification URL character for character: it is
# part of the signed payload, so it cannot be rebuilt from the incoming request.
SQUARE_WEBHOOK_URL=http://127.0.0.1:8000/api/integrations/square/webhook

# Fill in at deploy time. Keep blank in development.
SQUARE_PRODUCTION_APPLICATION_ID=
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_APPLICATION_SECRET=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=

# Optional overrides.
# SQUARE_CURRENCY=USD
# SQUARE_COUNTRY=US
# SQUARE_API_VERSION=2025-01-23
# SQUARE_OAUTH_SCOPES="MERCHANT_PROFILE_READ ORDERS_READ ORDERS_WRITE PAYMENTS_READ PAYMENTS_WRITE"
###< Square ###

###> Google SSO (OpenID Connect) ###
# https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID (Web)
# Authorized redirect URI (must match character-for-character):
#   Local:  http://127.0.0.1:8000/api/auth/sso/callback
#   Prod:   https://YOUR-API-HOST/api/auth/sso/callback
# SSO_OIDC_ISSUER=https://accounts.google.com
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_SCOPES="openid email profile"
# SSO_PROVIDER_NAME=Google
###< Google SSO ###

###> Mapbox (address autocomplete in onboarding) ###
# https://account.mapbox.com/access-tokens/ — use a secret token with geocoding scope.
# Leave blank to use mock suggestions locally (not for production).
# MAPBOX_ACCESS_TOKEN=
###< Mapbox ###
