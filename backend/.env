# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration
#
# ============================ SECURITY NOTICE ================================
# The values below are DEVELOPMENT-ONLY defaults. In production, OVERRIDE every
# secret (APP_SECRET, JWT_PASSPHRASE, DATABASE_URL, CORS_ALLOW_ORIGIN, MAILER_DSN)
# with real environment variables injected by your platform / secrets manager —
# never rely on the committed values. See README → "Production configuration".
# ============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=da28ded250ccfc4b77811667fdc92875
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://127.0.0.1:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://store:store@127.0.0.1:5432/store?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=8590e3f3e8b41e6c57a116f618411185d26961d7d478020699af716d12c8141f
###< lexik/jwt-authentication-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=csv_import&auto_setup=1
# Dead-letter queue for messages that exhaust their retries.
MESSENGER_FAILED_TRANSPORT_DSN=doctrine://default?queue_name=failed&auto_setup=1
###< symfony/messenger ###

###> square ###
# Real credentials belong in .env.local (gitignored) — see .env.local.example.
#
# Sandbox and production keys are held under separate names and
# SQUARE_ENVIRONMENT selects the pair, so deploying is a one-variable change
# and a half-finished switch can never send sandbox keys to the live API.
# SQUARE_ENVIRONMENT=sandbox
#
# SQUARE_SANDBOX_APPLICATION_ID=
# SQUARE_SANDBOX_ACCESS_TOKEN=
# SQUARE_SANDBOX_LOCATION_ID=
# SQUARE_SANDBOX_APPLICATION_SECRET=
# SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
#
# SQUARE_PRODUCTION_APPLICATION_ID=
# SQUARE_PRODUCTION_ACCESS_TOKEN=
# SQUARE_PRODUCTION_LOCATION_ID=
# SQUARE_PRODUCTION_APPLICATION_SECRET=
# SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
#
# Part of the webhook signature, so it must match the notification URL
# registered with Square exactly rather than being derived from the request.
# SQUARE_WEBHOOK_URL=
#
# SQUARE_OAUTH_SCOPES="MERCHANT_PROFILE_READ ORDERS_READ ORDERS_WRITE PAYMENTS_READ PAYMENTS_WRITE"
# SQUARE_CURRENCY=USD
# SQUARE_COUNTRY=US
# SQUARE_API_VERSION=2025-01-23
###< square ###

###> symfony/mailer ###
MAILER_DSN=smtp://127.0.0.1:1025
###< symfony/mailer ###

###> app/onboarding ###
# Where the React SPA runs. Approval emails link here, and SSO returns users here.
APP_FRONTEND_URL=http://localhost:5173
# From-address for outgoing mail (platform + store transactional).
APP_MAIL_FROM="LGS Card Vault <no-reply@marketplace.local>"
# Address autocomplete (leave blank to use built-in mock suggestions).
# MAPBOX_ACCESS_TOKEN=
# Subscription payments use the square block above: the ACCESS_TOKEN and
# LOCATION_ID there are the platform's own, charging store owners for their
# tier. The APPLICATION_SECRET is what lets a store connect its own Square
# account so it can charge its shoppers.
###< app/onboarding ###

###> app/sso (OpenID Connect) ###
# Enable single sign-on with ANY OIDC provider (Google, Microsoft Entra, Okta,
# Auth0, Keycloak…). Fill these three in and restart the API to turn it on.
# Register this redirect URI with your provider:
#   http://127.0.0.1:8000/api/auth/sso/callback
#
# Example (Google): SSO_OIDC_ISSUER=https://accounts.google.com
# SSO_OIDC_ISSUER=
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_SCOPES="openid email profile"
# SSO_PROVIDER_NAME="Google"
###< app/sso (OpenID Connect) ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> sentry ###
# Error tracking is OFF when empty. Set to your Sentry DSN in production.
SENTRY_DSN=
SENTRY_RELEASE=
###< sentry ###
