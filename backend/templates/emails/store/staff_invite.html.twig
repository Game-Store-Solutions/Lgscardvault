{% extends 'emails/layout.html.twig' %}

{% block content %}
  <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#111827;">
    You were added to {{ storeName }}
  </h1>
  <hr style="border:none;border-top:1px solid #e5e7eb;margin:0 0 20px;">
  <p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#4b5563;">
    Hi {{ displayName }},
  </p>
  <p style="margin:0 0 20px;font-size:15px;line-height:1.65;color:#4b5563;">
    <strong style="color:#111827;">{{ storeName }}</strong> added you as a store user
    {% if newAccount %}and created an account for this email.{% else %}on LGS Card Vault.{% endif %}
  </p>
  {% if newAccount %}
  <p style="margin:0 0 24px;font-size:15px;line-height:1.65;color:#4b5563;">
    Sign in with Google using this email, or use email and password after you set one from the sign-in page.
  </p>
  {% endif %}
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 16px;">
    <tr>
      <td align="center" style="border-radius:8px;background:{{ ctaColor|default('#0a1627') }};">
        <a href="{{ adminUrl }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;">
          Open store dashboard
        </a>
      </td>
    </tr>
  </table>
  <p style="margin:0;font-size:13px;line-height:1.6;color:#9ca3af;text-align:center;">
    Or sign in at <a href="{{ loginUrl }}" style="color:{{ accentColor|default('#c6a035') }};">{{ loginUrl }}</a>
  </p>
{% endblock %}
