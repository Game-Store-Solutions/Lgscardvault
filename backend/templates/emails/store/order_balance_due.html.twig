{% extends 'emails/layout.html.twig' %}

{% block content %}
  <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#111827;">
    Approve a PayPal charge
  </h1>
  <hr style="border:none;border-top:1px solid #e5e7eb;margin:0 0 20px;">
  <p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#4b5563;">
    Hi {{ customerName }},
  </p>
  <p style="margin:0 0 20px;font-size:15px;line-height:1.65;color:#4b5563;">
    <strong style="color:#111827;">{{ storeName }}</strong> added cards to your order. PayPal cannot add that extra to the original capture, so please approve this one additional payment.
  </p>

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 24px;background:#f9fafb;border-radius:8px;border-left:4px solid {{ accentColor|default('#c6a035') }};">
    <tr>
      <td style="padding:16px 18px;">
        <p style="margin:0 0 8px;font-size:13px;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;font-weight:600;">Charge details</p>
        <p style="margin:0 0 6px;font-size:15px;color:#111827;"><strong>Reference:</strong> {{ orderReference }}</p>
        <p style="margin:0 0 6px;font-size:15px;color:#111827;"><strong>Store:</strong> {{ storeName }}</p>
        <p style="margin:0;font-size:15px;color:#111827;"><strong>Amount due:</strong> ${{ amountFormatted }}</p>
      </td>
    </tr>
  </table>

  <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 16px;">
    <tr>
      <td align="center" style="border-radius:8px;background:{{ ctaColor|default('#0a1627') }};">
        <a href="{{ orderUrl }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;">
          Approve on PayPal
        </a>
      </td>
    </tr>
  </table>
  <p style="margin:0;font-size:13px;line-height:1.6;color:#9ca3af;text-align:center;">
    You can also pay this extra at the counter with staff.
  </p>
{% endblock %}
