{% extends 'emails/layout.html.twig' %}

{% block content %}
  <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#111827;">
    New marketplace enquiry
  </h1>
  <hr style="border:none;border-top:1px solid #e5e7eb;margin:0 0 20px;">
  <p style="margin:0 0 8px;font-size:15px;line-height:1.65;color:#4b5563;">
    <strong style="color:#111827;">{{ senderName }}</strong> got in touch through the landing page.
  </p>
  <p style="margin:0 0 20px;font-size:15px;line-height:1.65;color:#4b5563;">
    Reply to
    <a href="mailto:{{ senderEmail }}" style="color:{{ accentColor|default('#c6a035') }};">{{ senderEmail }}</a>.
  </p>
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:0 0 20px;">
    <tr>
      <td style="padding:16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;font-size:15px;line-height:1.65;color:#374151;white-space:pre-wrap;">{{ messageBody }}</td>
    </tr>
  </table>
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto;">
    <tr>
      <td align="center" style="border-radius:8px;background:{{ ctaColor|default('#0a1627') }};">
        <a href="mailto:{{ senderEmail }}?subject={{ ('Re: your LGS Card Vault enquiry')|url_encode }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;">
          Reply to {{ senderName }}
        </a>
      </td>
    </tr>
  </table>
{% endblock %}
