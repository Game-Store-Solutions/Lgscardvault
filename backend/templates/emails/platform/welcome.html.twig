{% extends 'emails/layout.html.twig' %}

{% block content %}
  <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#111827;">
    Welcome to LGS Card Vault
  </h1>
  <hr style="border:none;border-top:1px solid #e5e7eb;margin:0 0 20px;">
  <p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#4b5563;">
    Hi {{ displayName }},
  </p>
  <p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#4b5563;">
    Your account is ready. Browse singles from trusted local game stores, save favorites, and check out faster with one login across the marketplace.
  </p>
  {% if isOwner %}
  <p style="margin:0 0 24px;font-size:15px;line-height:1.65;color:#4b5563;">
    As a store owner, you can finish onboarding and open your storefront whenever you’re ready.
  </p>
  {% else %}
  <p style="margin:0 0 24px;font-size:15px;line-height:1.65;color:#4b5563;">
    Start by exploring live stores and building your want list.
  </p>
  {% endif %}
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 20px;">
    <tr>
      <td align="center" style="border-radius:8px;background:{{ ctaColor|default('#0a1627') }};">
        <a href="{{ ctaUrl }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;">
          {{ ctaLabel }}
        </a>
      </td>
    </tr>
  </table>
  <p style="margin:0;font-size:13px;line-height:1.6;color:#9ca3af;text-align:center;">
    Or open <a href="{{ frontendUrl }}" style="color:{{ accentColor|default('#c6a035') }};">{{ frontendUrl }}</a> in your browser.
  </p>
{% endblock %}
