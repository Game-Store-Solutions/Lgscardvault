{% extends 'emails/layout.html.twig' %}

{% block content %}
  <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#111827;">
    Confirm your email
  </h1>
  <hr style="border:none;border-top:1px solid #e5e7eb;margin:0 0 20px;">
  <p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#4b5563;">
    Hi {{ displayName }},
  </p>
  <p style="margin:0 0 24px;font-size:15px;line-height:1.65;color:#4b5563;">
    Thanks for creating an LGS Card Vault account. Confirm this email address to finish signing up. This link expires in 24 hours.
  </p>
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 16px;">
    <tr>
      <td align="center" style="border-radius:8px;background:{{ ctaColor|default('#0a1627') }};">
        <a href="{{ verifyUrl }}" style="display:inline-block;padding:12px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;">
          Verify email
        </a>
      </td>
    </tr>
  </table>
  <p style="margin:0;font-size:13px;line-height:1.6;color:#9ca3af;text-align:center;">
    Or open <a href="{{ verifyUrl }}" style="color:{{ accentColor|default('#c6a035') }};">this verification link</a> in your browser.
  </p>
{% endblock %}
