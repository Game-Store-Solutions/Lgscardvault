# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The test env appends a "_test" suffix to the DATABASE_URL dbname (see
# config/packages/doctrine.yaml when@test), so the dev "store" database
# becomes "store_test" here automatically — a dedicated DB that a test run can
# migrate and truncate without touching development data. DAMA additionally
# wraps each test in a transaction and rolls it back, so the migrated schema is
# shared across tests without cross-test pollution.

# No real mail in tests — discard messages silently.
MAILER_DSN=null://null

# Webhook signing material for the Square callback tests. Real credentials live
# in .env.local, which Symfony deliberately does not load under APP_ENV=test, so
# the suite can never sign or send anything to the live API.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=test-webhook-signature-key
SQUARE_WEBHOOK_URL=http://localhost/api/integrations/square/webhook

PAYPAL_ENVIRONMENT=sandbox
PAYPAL_SANDBOX_WEBHOOK_ID=test-paypal-webhook-id

LEGAL_ENTITY_NAME="LGS Card Vault"
LEGAL_CONTACT_EMAIL=privacy@lgscardvault.com
LEGAL_ADDRESS=
